# ============================================================
# BusinessSAAS — Root Environment Variables
# ============================================================
# This is the ONLY .env file needed when running with Docker.
# Docker Compose reads this file and distributes the right
# variables to each container via docker-compose.yml.
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in real values (especially secrets marked CHANGE THIS)
#   Never commit .env to Git — it is in .gitignore
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_ENV=development

# ----------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=businesssaas
POSTGRES_HOST_PORT=5432

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_PASSWORD=change_this_redis_password
REDIS_HOST_PORT=6379

# ----------------------------------------------------------
# Backend
# ----------------------------------------------------------
APP_PORT=8080
BACKEND_HOST_PORT=8080

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=change_this_jwt_secret_minimum_32_characters_long
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# CORS — what origins are allowed to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----------------------------------------------------------
# Cookie (httpOnly refresh token set by Go backend)
# ----------------------------------------------------------
COOKIE_NAME=bsaas_refresh
# false for local HTTP development, true in production (requires HTTPS)
COOKIE_SECURE=false
# Strict = safest. Change to Lax only if OAuth redirects break.
COOKIE_SAME_SITE=Strict
# Leave empty for localhost. In production: .yourdomain.com
COOKIE_DOMAIN=
# Limits cookie to auth endpoints only — do not change
COOKIE_PATH=/api/v1/auth

# ----------------------------------------------------------
# Frontend
# ----------------------------------------------------------
FRONTEND_HOST_PORT=3000
FRONTEND_URL=http://localhost:3000

# URL the BROWSER uses to call the backend (must be reachable from user's machine)
NEXT_PUBLIC_API_URL=http://localhost:8080

# next-auth v5 — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change_this_nextauth_secret_min_32_characters
NEXTAUTH_URL=http://localhost:3000
