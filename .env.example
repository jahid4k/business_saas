# ============================================================
# BusinessSAAS — Root Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# This file is safe to commit — it contains no real secrets.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_ENV=development

# ----------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=businesssaas
POSTGRES_HOST_PORT=5432

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_PASSWORD=change_this_redis_password
REDIS_HOST_PORT=6379

# ----------------------------------------------------------
# Backend
# ----------------------------------------------------------
APP_PORT=8080
BACKEND_HOST_PORT=8080

# JWT — use a long random secret (min 32 chars) in production
JWT_SECRET=change_this_jwt_secret_minimum_32_characters_long
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----------------------------------------------------------
# Frontend
# ----------------------------------------------------------
FRONTEND_HOST_PORT=3000
FRONTEND_URL=http://localhost:3000

# Public API URL — what the browser uses to call the backend
NEXT_PUBLIC_API_URL=http://localhost:8080
