# ============================================================
# BusinessSAAS — .gitignore
# ============================================================

# ----------------------------------------------------------
# Environment files — NEVER commit these
# ----------------------------------------------------------
.env
.env.local
.env.production
.env.staging
*.env
MarkdownTreeView.md

# ----------------------------------------------------------
# OS
# ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
compose.md

# ----------------------------------------------------------
# IDE / Editor
# ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.suo
*.user
*.sublime-workspace
*.sublime-project
.fleet/

# ----------------------------------------------------------
# Go
# ----------------------------------------------------------
backend/vendor/
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/tmp/
backend/bin/

# ----------------------------------------------------------
# Node / Next.js
# ----------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.npm
frontend/.eslintcache
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ----------------------------------------------------------
# Node / Expo React Native
# ----------------------------------------------------------
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.eslintcache
mobile/*.tsbuildinfo

# Native projects — generated by `expo prebuild` (Continuous Native
# Generation / managed workflow). Ignored on the assumption you're staying
# in CNG, not ejecting. If you ever add custom native code and stop
# regenerating these from app.json + config plugins, un-ignore both lines
# below and commit them instead.
mobile/android/
mobile/ios/

# Local build output (e.g. `eas build --local`, `expo run:android`)
mobile/*.apk
mobile/*.aab
mobile/*.ipa

# Signing / provisioning — not already covered by the global Secrets/Keys
# section below (*.pem / *.key / *.p12 / *.pfx are already global)
mobile/*.jks
mobile/*.mobileprovision
mobile/*.orig.*

# Metro bundler / package-manager debug logs
mobile/.metro-health-check*
mobile/npm-debug.*
mobile/yarn-debug.*
mobile/yarn-error.*

# ----------------------------------------------------------
# Docker
# ----------------------------------------------------------
*.log

# ----------------------------------------------------------
# Database / migrations
# ----------------------------------------------------------
*.dump
*.sql.bak

# ----------------------------------------------------------
# Secrets / Keys
# ----------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# ----------------------------------------------------------
# Test / Coverage
# ----------------------------------------------------------
backend/coverage/
frontend/coverage/
*.cover
*.out*.zip

# ----------------------------------------------------------
# User-uploaded files (avatars, etc.) — real content lives on
# disk/volume per environment, never in git
# ----------------------------------------------------------
backend/uploads/
backend/storage/
# go test's CWD is the package directory, not backend/ — resume uploads in
# internal/tests/integration land in a storage/ dir there, not backend/storage/
backend/**/storage/