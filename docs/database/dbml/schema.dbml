Project BusinessSAAS {
  database_type: 'PostgreSQL'
  Note: 'Generated from BusinessSAAS Phase 1 migrations. HRM tables (40, migrations 00021-00046) added r9 — generated programmatically from source SQL, not hand-transcribed. CRM and platform tables are not yet represented in this DBML file — same gap as data-dictionary.md and erd.md before r9.'
}

Table users {
  id uuid [pk]
  public_id text [unique]
  email text
  password_hash text
  username text
  display_name text
  first_name text
  last_name text
  full_name text
  photo_url text
  cover_photo_url text
  phone text
  phone_verified boolean
  email_verified boolean
  email_verified_at timestamptz
  country char
  timezone text
  locale text
  language text
  currency text
  status text
  account_type text
  suspended_at timestamptz
  suspension_reason text
  login_redirect_url text
  shortcuts text
  settings jsonb
  preferences jsonb
  onboarding jsonb
  feature_flags jsonb
  two_fa_enabled boolean
  two_fa_secret text
  backup_codes jsonb
  last_login_at timestamptz
  last_activity_at timestamptz
  failed_logins integer
  locked_until timestamptz
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

